[Unit]
Description=Luminous LiveKit voice agent
After=network-online.target luminous-api.service
Wants=network-online.target
Requires=luminous-api.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=luminous
Group=luminous
WorkingDirectory=/opt/luminous/current
EnvironmentFile=/etc/luminous/luminous.env
ExecStart=/opt/luminous/current/.venv/bin/luminous-livekit-agent start
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/luminous
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
