[Unit]
Description=Luminous LiveKit media server (WSL user service)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/wz/luminous
ExecStart=/home/wz/.local/share/luminous-livekit/bin/livekit-server --config /home/wz/.config/luminous/livekit.yaml --key-file /home/wz/.config/luminous/livekit.keys
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
LimitNOFILE=65535
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
