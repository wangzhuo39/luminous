[Unit]
Description=Luminous companion API and web application (user service)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/wz/luminous
EnvironmentFile=/home/wz/luminous/.env
ExecStart=/home/wz/luminous/.venv/bin/luminous-api --project-root /home/wz/luminous --env /home/wz/luminous/.env --frontend /home/wz/luminous/apps/companion-web/companion-ui --host 127.0.0.1 --port 8000 --deployment-mode public
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
