[Unit]
Description=Luminous LiveKit voice agent (user service)
After=network-online.target luminous-api.service
Wants=network-online.target
Requires=luminous-api.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/wz/luminous
EnvironmentFile=/home/wz/luminous/.env
ExecStart=/home/wz/luminous/.venv/bin/luminous-livekit-agent start
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
