[Unit]
Description=Luminous companion API and web application
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=luminous
Group=luminous
WorkingDirectory=/opt/luminous/current
EnvironmentFile=/etc/luminous/luminous.env
ExecStart=/opt/luminous/current/.venv/bin/luminous-api --project-root /opt/luminous/current --env /etc/luminous/luminous.env --frontend /opt/luminous/current/apps/companion-web/companion-ui --host 127.0.0.1 --port 8000 --deployment-mode public
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/luminous
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
