[Unit]
Description=Create a verified online backup of Luminous data
After=luminous-api.service

[Service]
Type=oneshot
User=luminous
Group=luminous
WorkingDirectory=/opt/luminous/current
EnvironmentFile=/etc/luminous/luminous.env
ExecStart=/opt/luminous/current/.venv/bin/luminous-backup backup --env /etc/luminous/luminous.env --backup-root /var/lib/luminous/backups
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/luminous
