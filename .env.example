# Public mobile test boundary
LUMINOUS_DEPLOYMENT_MODE=public
LUMINOUS_DATA_DIR=/var/lib/luminous/runtime
LUMINOUS_CORS_ORIGINS=https://luminous.example.com,https://localhost
LUMINOUS_PUBLIC_URL=https://luminous.example.com

# Generate each secret independently. Do not commit real values.
LUMINOUS_TESTER_ACCESS_CODE=replace-with-a-private-invite-code
LUMINOUS_SESSION_SECRET=replace-with-python-secrets-token-urlsafe-48
LUMINOUS_AUTH_TOKEN=replace-with-python-secrets-token-urlsafe-48
LUMINOUS_SESSION_TTL_SECONDS=604800
LUMINOUS_SESSION_IDLE_SECONDS=86400

# OpenAI-compatible model endpoint
ROLE_PLAY_BASE_URL=https://api.example.com/v1
ROLE_PLAY_API_KEY=replace-with-provider-key
ROLE_PLAY_MODEL=replace-with-model-name
ROLE_PLAY_TEMPERATURE=0.7
ROLE_PLAY_TIMEOUT=120
ROLE_PLAY_MAX_TOKENS=768
ROLE_PLAY_MOCK=false

# Server-only voice message processing. Never expose these values in the user settings UI.
LUMINOUS_STT_PROVIDER=qwen-voice
LUMINOUS_STT_BASE_URL=https://stt.example.com
LUMINOUS_STT_API_KEY=replace-with-provider-key
LUMINOUS_STT_MODEL=qwen3-asr
LUMINOUS_STT_STREAM_URL=wss://stt-stream.example.com/v1/asr/stream

LUMINOUS_TTS_PROVIDER=qwen-voice
LUMINOUS_TTS_BASE_URL=https://tts.example.com
LUMINOUS_TTS_API_KEY=replace-with-provider-key
LUMINOUS_TTS_MODEL=cosyvoice3
LUMINOUS_TTS_STREAM_URL=wss://tts.example.com/v1/tts/stream
LUMINOUS_TTS_VOICE=default
LUMINOUS_TTS_INSTRUCT_TEXT=保持叶筝平时的声音。平静、自然、略微克制。语速中等略慢。没有明显笑意。句尾自然收住。

# Android App reads proactive messages from the internal outbox and shows local notifications.
ROLE_PLAY_NOTIFY_ENABLED=true
ROLE_PLAY_NOTIFY_CHANNEL=internal
ROLE_PLAY_NOTIFY_BARK_URL=
ROLE_PLAY_NOTIFY_TELEGRAM_BOT_TOKEN=
ROLE_PLAY_NOTIFY_TELEGRAM_CHAT_ID=
ROLE_PLAY_NOTIFY_TIMEOUT=10
